{
  "openapi": "3.0.0",
  "info": {
    "title": "Internal Campaigns & Participants API",
    "description": "API pour gérer les campagnes internes et leurs participants",
    "version": "1.0.0",
    "contact": {
      "name": "Support API"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000/api",
      "description": "Development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Module": {
        "type": "object",
        "required": ["type", "order"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["QUESTIONNAIRE", "AI_INTERVIEW", "SKILL_TEST", "TRAINING_PATH"],
            "description": "Type de module"
          },
          "config": {
            "type": "object",
            "description": "Configuration spécifique du module"
          },
          "order": {
            "type": "number",
            "description": "Ordre d'affichage du module"
          }
        }
      },
      "InternalCampaign": {
        "type": "object",
        "required": ["title", "type", "anonymityMode", "modules", "accessMethod"],
        "properties": {
          "_id": {
            "type": "string",
            "description": "ID unique de la campagne"
          },
          "company": {
            "type": "string",
            "description": "ID de l'entreprise"
          },
          "title": {
            "type": "string",
            "description": "Titre de la campagne"
          },
          "type": {
            "type": "string",
            "enum": ["PRODUCTIVITY_DIAGNOSTIC", "SKILLS_MAPPING", "ENABLEMENT", "CUSTOM"],
            "description": "Type de campagne"
          },
          "description": {
            "type": "string",
            "description": "Description de la campagne"
          },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "ACTIVE", "PAUSED", "CLOSED", "EXPIRED"],
            "default": "DRAFT",
            "description": "Statut de la campagne"
          },
          "anonymityMode": {
            "type": "string",
            "enum": ["ANONYMOUS", "NOMINATIVE"],
            "description": "Mode d'anonymat"
          },
          "modules": {
            "type": "object",
            "$ref": "#/components/schemas/Module",
            "description": "Module de la campagne"
          },
          "accessMethod": {
            "type": "string",
            "enum": ["LINK", "ACCOUNTS", "BOTH"],
            "description": "Méthode d'accès"
          },
          "linkToken": {
            "type": "string",
            "description": "Token d'accès par lien"
          },
          "targetDepartment": {
            "type": "string",
            "description": "Département cible"
          },
          "targetEmployeeCount": {
            "type": "number",
            "description": "Nombre d'employés cibles"
          },
          "deadline": {
            "type": "string",
            "format": "date-time",
            "description": "Date limite de la campagne"
          },
          "skill": {
            "type": "string",
            "description": "Compétence à évaluer"
          },
          "createdBy": {
            "type": "string",
            "description": "ID de l'utilisateur qui a créé la campagne"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CampaignParticipant": {
        "type": "object",
        "required": ["campaign"],
        "properties": {
          "_id": {
            "type": "string",
            "description": "ID unique du participant"
          },
          "campaign": {
            "type": "string",
            "description": "ID de la campagne"
          },
          "employee": {
            "type": "string",
            "description": "ID de l'employé (si connu)"
          },
          "anonymousToken": {
            "type": "string",
            "description": "Token pour les participants anonymes"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email du participant"
          },
          "status": {
            "type": "string",
            "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED"],
            "default": "NOT_STARTED"
          },
          "accessedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date d'accès à la campagne"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date de complétion"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CampaignStats": {
        "type": "object",
        "properties": {
          "campaignId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "totalParticipants": {
            "type": "number"
          },
          "participantStats": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string"
                },
                "count": {
                  "type": "number"
                }
              }
            }
          },
          "moduleStats": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "CampaignMetrics": {
        "type": "object",
        "properties": {
          "total": { "type": "number" },
          "active": { "type": "number" },
          "draft": { "type": "number" },
          "closed": { "type": "number" },
          "paused": { "type": "number" },
          "expired": { "type": "number" }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/internal-campaigns": {
      "post": {
        "tags": ["Internal Campaigns"],
        "summary": "Créer une nouvelle campagne",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "type", "anonymityMode", "modules", "accessMethod"],
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Employee Skills Assessment 2026"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["PRODUCTIVITY_DIAGNOSTIC", "SKILLS_MAPPING", "ENABLEMENT", "CUSTOM"],
                    "example": "SKILLS_MAPPING"
                  },
                  "description": {
                    "type": "string",
                    "example": "Évaluer les compétences actuelles des employés"
                  },
                  "anonymityMode": {
                    "type": "string",
                    "enum": ["ANONYMOUS", "NOMINATIVE"],
                    "example": "NOMINATIVE"
                  },
                  "modules": {
                    "type": "object",
                    "$ref": "#/components/schemas/Module",
                    "example": {
                      "type": "QUESTIONNAIRE",
                      "order": 1,
                      "config": {}
                    }
                  },
                  "accessMethod": {
                    "type": "string",
                    "enum": ["LINK", "ACCOUNTS", "BOTH"],
                    "example": "BOTH"
                  },
                  "targetDepartment": {
                    "type": "string",
                    "example": "Engineering"
                  },
                  "targetEmployeeCount": {
                    "type": "number",
                    "example": 50
                  },
                  "deadline": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-03-31T23:59:59Z"
                  },
                  "skill": {
                    "type": "string",
                    "description": "Compétence à évaluer",
                    "example": "Leadership, Communication, Problem Solving"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Campagne créée avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/InternalCampaign"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Champs obligatoires manquants",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Internal Campaigns"],
        "summary": "Récupérer toutes les campagnes de l'entreprise",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filtrer par statut",
            "schema": {
              "type": "string",
              "enum": ["DRAFT", "ACTIVE", "PAUSED", "CLOSED", "EXPIRED"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des campagnes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/InternalCampaign"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal-campaigns/metrics": {
      "get": {
        "tags": ["Internal Campaigns"],
        "summary": "Obtenir les métriques des campagnes",
        "security": [
          { "bearerAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "Métriques des campagnes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/CampaignMetrics" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal-campaigns/{campaignId}/modules/{moduleId}/config": {
      "patch": {
        "tags": ["Internal Campaigns"],
        "summary": "Modifier la configuration d'un module",
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "moduleId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "config": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configuration du module mise à jour"
          }
        }
      }
    },
    "/internal-campaigns/{campaignId}": {
      "get": {
        "tags": ["Internal Campaigns"],
        "summary": "Récupérer une campagne spécifique",
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Campagne trouvée",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/InternalCampaign" }
                  }
                }
              }
            }
          },
          "404": { "description": "Campagne non trouvée" }
        }
      },
      "put": {
        "tags": ["Internal Campaigns"],
        "summary": "Mettre à jour une campagne",
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "status": {
                    "type": "string",
                    "enum": ["DRAFT", "ACTIVE", "PAUSED", "CLOSED", "EXPIRED"]
                  },
                  "modules": {
                    "type": "object",
                    "$ref": "#/components/schemas/Module"
                  },
                  "deadline": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Campagne mise à jour",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/InternalCampaign" }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Internal Campaigns"],
        "summary": "Supprimer une campagne",
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Campagne supprimée" },
          "404": { "description": "Campagne non trouvée" }
        }
      }
    },
    "/internal-campaigns/{campaignId}/stats": {
      "get": {
        "tags": ["Internal Campaigns"],
        "summary": "Obtenir les statistiques d'une campagne",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Statistiques de la campagne",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/CampaignStats"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal-campaigns/{campaignId}/status": {
      "patch": {
        "tags": ["Internal Campaigns"],
        "summary": "Changer le statut d'une campagne",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["DRAFT", "ACTIVE", "PAUSED", "CLOSED", "EXPIRED"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Statut mis à jour"
          }
        }
      }
    },
    "/campaign-participants/{campaignId}/participants": {
      "post": {
        "tags": ["Campaign Participants"],
        "summary": "Ajouter un participant à une campagne",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "john@example.com"
                  },
                  "employeeId": {
                    "type": "string",
                    "description": "ID de l'employé interne"
                  },
                  "anonymousToken": {
                    "type": "string",
                    "description": "Token pour accès anonyme"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Participant ajouté",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/CampaignParticipant"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Campaign Participants"],
        "summary": "Récupérer les participants d'une campagne",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["INVITED", "IN_PROGRESS", "COMPLETED", "DROPPED"]
            },
            "description": "Filtrer par statut"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des participants",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CampaignParticipant"
                      }
                    },
                    "count": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/campaign-participants/{campaignId}/participants/bulk": {
      "post": {
        "tags": ["Campaign Participants"],
        "summary": "Ajouter plusieurs participants en masse",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["participants"],
                "properties": {
                  "participants": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "employeeId": {
                          "type": "string"
                        },
                        "anonymousToken": {
                          "type": "string"
                        }
                      }
                    },
                    "example": [
                      {
                        "email": "john@example.com"
                      },
                      {
                        "email": "jane@example.com"
                      },
                      {
                        "employeeId": "emp123"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Participants ajoutés"
          }
        }
      }
    },
    "/campaign-participants/{participantId}": {
      "get": {
        "tags": ["Campaign Participants"],
        "summary": "Récupérer un participant spécifique",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "participantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Participant trouvé",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/CampaignParticipant"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Participant non trouvé"
          }
        }
      },
      "put": {
        "tags": ["Campaign Participants"],
        "summary": "Mettre à jour un participant",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "participantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["INVITED", "IN_PROGRESS", "COMPLETED", "DROPPED"]
                  },
                  "accessedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "completedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Participant mis à jour"
          }
        }
      },
      "delete": {
        "tags": ["Campaign Participants"],
        "summary": "Supprimer un participant",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "participantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Participant supprimé"
          }
        }
      }
    },
    "/campaign-participants/{participantId}/module-progress": {
      "put": {
        "tags": ["Campaign Participants"],
        "summary": "Mettre à jour la progression d'un module",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "participantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["moduleType", "status"],
                "properties": {
                  "moduleType": {
                    "type": "string",
                    "enum": ["QUESTIONNAIRE", "AI_INTERVIEW", "SKILL_TEST", "TRAINING_PATH"],
                    "example": "QUESTIONNAIRE"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED"],
                    "example": "COMPLETED"
                  },
                  "completedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "responseRef": {
                    "type": "string",
                    "description": "ID de la réponse ou évaluation"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Progression mise à jour"
          }
        }
      }
    },
    "/campaign-participants/{participantId}/drop": {
      "patch": {
        "tags": ["Campaign Participants"],
