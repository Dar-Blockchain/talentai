{
  "openapi": "3.0.0",
  "info": {
    "title": "Departments API",
    "description": "API pour gérer les départements d'une entreprise avec pagination et recherche",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    },
    {
      "url": "http://localhost:3000",
      "description": "Alternative local server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "DepartmentInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Engineering",
            "description": "Department name (required, unique per company)"
          },
          "description": {
            "type": "string",
            "example": "All engineering and technical teams",
            "description": "Department description (optional)"
          }
        },
        "required": ["name"]
      },
      "Department": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "65f1a2b3c4d5e6f7g8h9i0j1"
          },
          "name": {
            "type": "string",
            "example": "Engineering"
          },
          "description": {
            "type": "string",
            "example": "All engineering and technical teams"
          },
          "companyId": {
            "type": "string",
            "example": "65f1a2b3c4d5e6f7g8h9i0j1"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-03T12:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-03T12:00:00.000Z"
          }
        },
        "required": ["_id", "name", "companyId"]
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "limit": {
            "type": "integer",
            "example": 20
          },
          "total": {
            "type": "integer",
            "example": 42
          },
          "pages": {
            "type": "integer",
            "example": 3
          }
        }
      },
      "PaginatedDepartmentResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Department"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "DepartmentResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "$ref": "#/components/schemas/Department"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "example": "Department not found"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/departments": {
      "post": {
        "tags": ["Departments"],
        "summary": "Create a new department",
        "description": "Create a new department for the authenticated company",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepartmentInput"
              },
              "examples": {
                "engineering": {
                  "value": {
                    "name": "Engineering",
                    "description": "Engineering and R&D team"
                  }
                },
                "sales": {
                  "value": {
                    "name": "Sales",
                    "description": "Sales and business development"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Department created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepartmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input - name is required or name already exists for this company",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid token"
          },
          "403": {
            "description": "Forbidden - user must have Company role"
          }
        }
      },
      "get": {
        "tags": ["Departments"],
        "summary": "List company departments",
        "description": "Returns paginated list of departments for the authenticated company. Supports optional name search.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Partial name to search for (case-insensitive, regex-enabled)",
            "example": "eng"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "description": "Page number for pagination"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            },
            "description": "Number of items per page (max 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "List of departments retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedDepartmentResponse"
                },
                "examples": {
                  "withResults": {
                    "value": {
                      "success": true,
                      "data": [
                        {
                          "_id": "65f1a2b3c4d5e6f7g8h9i0j1",
                          "name": "Engineering",
                          "description": "Engineering team",
                          "companyId": "65f1a2b3c4d5e6f7g8h9i0j2",
                          "createdAt": "2026-03-01T10:00:00.000Z",
                          "updatedAt": "2026-03-01T10:00:00.000Z"
                        }
                      ],
                      "pagination": {
                        "page": 1,
                        "limit": 20,
                        "total": 5,
                        "pages": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid token"
          },
          "403": {
            "description": "Forbidden - user must have Company role"
          }
        }
      }
    },
    "/departments/{id}": {
      "get": {
        "tags": ["Departments"],
        "summary": "Get a specific department",
        "description": "Retrieve details of a single department by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Department ID",
            "example": "65f1a2b3c4d5e6f7g8h9i0j1"
          }
        ],
        "responses": {
          "200": {
            "description": "Department retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepartmentResponse"
                }
              }
            }
          },
          "404": {
            "description": "Department not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid token"
          },
          "403": {
            "description": "Forbidden - user must have Company role"
          }
        }
      },
      "put": {
        "tags": ["Departments"],
        "summary": "Update a department",
        "description": "Update name and/or description of a department. Company ID cannot be changed.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Department ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepartmentInput"
              },
              "examples": {
                "updateName": {
                  "value": {
                    "name": "R&D Department"
                  }
                },
                "updateBoth": {
                  "value": {
                    "name": "Product Team",
                    "description": "Product development and innovation"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Department updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepartmentResponse"
                }
              }
            }
          },
          "404": {
            "description": "Department not found"
          },
          "400": {
            "description": "Invalid input or name already exists for this company"
          },
          "401": {
            "description": "Unauthorized - missing or invalid token"
          },
          "403": {
            "description": "Forbidden - user must have Company role"
          }
        }
      },
      "delete": {
        "tags": ["Departments"],
        "summary": "Delete a department",
        "description": "Permanently delete a department by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Department ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Department deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Department deleted"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Department not found"
          },
          "401": {
            "description": "Unauthorized - missing or invalid token"
          },
          "403": {
            "description": "Forbidden - user must have Company role"
          }
        }
      }
    }
  }
}
