              "host": ["{{base_url}}"],
              "path": ["campaign-participants", "{{participant_id}}"]
            }
          }
        },
        {
          "name": "Get Participant by Token (No Auth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/campaign-participants/token/{{anonymous_token}}",
              "host": ["{{base_url}}"],
              "path": ["campaign-participants", "token", "{{anonymous_token}}"]
            }
          }
        },
        {
          "name": "Update Participant",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
