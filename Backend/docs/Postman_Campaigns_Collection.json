              "host": ["{{base_url}}"],
              "path": ["campaign-participants", "{{participant_id}}"]
            }
          }
        },
        {
          "name": "Update Module Progress",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"moduleType\": \"QUESTIONNAIRE\",\n  \"status\": \"COMPLETED\",\n  \"completedAt\": \"2026-02-19T11:45:00Z\",\n  \"responseRef\": \"response_id_12345\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/campaign-participants/{{participant_id}}/module-progress",
              "host": ["{{base_url}}"],
              "path": ["campaign-participants", "{{participant_id}}", "module-progress"]
