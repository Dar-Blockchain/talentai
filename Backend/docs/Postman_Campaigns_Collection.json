{
  "info": {
    "name": "Internal Campaigns & Participants API",
    "description": "Collection pour tester l'API des Campagnes Internes et Participants",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Internal Campaigns",
      "item": [
        {
          "name": "Create Campaign",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Employee Skills Assessment 2026\",\n  \"type\": \"SKILLS_MAPPING\",\n  \"description\": \"Assess current employee skills\",\n  \"anonymityMode\": \"NOMINATIVE\",\n  \"modules\": [\n    {\n      \"type\": \"QUESTIONNAIRE\",\n      \"order\": 1,\n      \"config\": {}\n    },\n    {\n      \"type\": \"SKILL_TEST\",\n      \"order\": 2,\n      \"config\": {}\n    }\n  ],\n  \"accessMethod\": \"BOTH\",\n  \"targetDepartment\": \"Engineering\",\n  \"targetEmployeeCount\": 50,\n  \"deadline\": \"2026-03-31T23:59:59Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/internal-campaigns",
              "host": ["{{base_url}}"],
              "path": ["internal-campaigns"]
            }
          }
        },
        {
          "name": "Get All Campaigns",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/internal-campaigns?status=ACTIVE",
              "host": ["{{base_url}}"],
              "path": ["internal-campaigns"],
              "query": [
                {
                  "key": "status",
                  "value": "ACTIVE"
                }
              ]
            }
          }
        },
        {
          "name": "Get Campaign by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/internal-campaigns/{{campaign_id}}",
              "host": ["{{base_url}}"],
              "path": ["internal-campaigns", "{{campaign_id}}"]
            }
          }
        },
        {
          "name": "Update Campaign",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Campaign Title\",\n  \"description\": \"Updated description\",\n  \"deadline\": \"2026-04-30T23:59:59Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/internal-campaigns/{{campaign_id}}",
              "host": ["{{base_url}}"],
              "path": ["internal-campaigns", "{{campaign_id}}"]
            }
          }
        },
        {
          "name": "Change Campaign Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/internal-campaigns/{{campaign_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["internal-campaigns", "{{campaign_id}}", "status"]
            }
          }
        },
        {
          "name": "Get Campaign Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/internal-campaigns/{{campaign_id}}/stats",
              "host": ["{{base_url}}"],
              "path": ["internal-campaigns", "{{campaign_id}}", "stats"]
            }
          }
        },
        {
          "name": "Delete Campaign",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/internal-campaigns/{{campaign_id}}",
              "host": ["{{base_url}}"],
              "path": ["internal-campaigns", "{{campaign_id}}"]
            }
          }
        }
      ]
    },
    {
