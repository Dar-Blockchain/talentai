                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/campaign-participants/{{campaign_id}}/participants?status=IN_PROGRESS",
              "host": ["{{base_url}}"],
              "path": ["campaign-participants", "{{campaign_id}}", "participants"],
              "query": [
                {
                  "key": "status",
                  "value": "IN_PROGRESS"
                }
              ]
            }
          }
        },
