                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/campaign-participants/{{campaign_id}}/participants",
              "host": ["{{base_url}}"],
              "path": ["campaign-participants", "{{campaign_id}}", "participants"]
            }
          }
        },
        {
          "name": "Add Multiple Participants (Bulk)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participants\": [\n    { \"email\": \"john@example.com\" },\n    { \"email\": \"jane@example.com\" },\n    { \"employeeId\": \"emp_123\" },\n    { \"email\": \"bob@example.com\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/campaign-participants/{{campaign_id}}/participants/bulk",
              "host": ["{{base_url}}"],
              "path": ["campaign-participants", "{{campaign_id}}", "participants", "bulk"]
