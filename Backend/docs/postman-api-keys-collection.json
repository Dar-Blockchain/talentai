{
  "info": {
    "_postman_id": "api-keys-collection",
    "name": "API Keys Management",
    "description": "Collection pour gérer les clés API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create API Key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Frontend App\",\n  \"serviceName\": \"frontend\",\n  \"scopes\": [\"read:posts\", \"write:posts\"],\n  \"rateLimit\": 5000,\n  \"expiresAt\": \"2025-12-31T23:59:59Z\",\n  \"ipWhitelist\": []\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/api-keys",
          "host": ["{{base_url}}"],
          "path": ["api", "api-keys"]
        }
      }
    },
    {
      "name": "List API Keys",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/api-keys",
          "host": ["{{base_url}}"],
          "path": ["api", "api-keys"]
        }
      }
    },
    {
      "name": "Get API Key Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/api-keys/{{api_key_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "api-keys", "{{api_key_id}}"]
        }
      }
    },
    {
      "name": "Update API Key",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Frontend App v2\",\n  \"scopes\": [\"read:posts\", \"write:posts\", \"read:profiles\"],\n  \"rateLimit\": 10000\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/api-keys/{{api_key_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "api-keys", "{{api_key_id}}"]
        }
      }
    },
    {
      "name": "Toggle API Key",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/api-keys/{{api_key_id}}/toggle",
          "host": ["{{base_url}}"],
          "path": ["api", "api-keys", "{{api_key_id}}", "toggle"]
        }
      }
    },
    {
      "name": "Regenerate API Key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/api-keys/{{api_key_id}}/regenerate",
          "host": ["{{base_url}}"],
          "path": ["api", "api-keys", "{{api_key_id}}", "regenerate"]
        }
      }
    },
    {
      "name": "Delete API Key",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/api-keys/{{api_key_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "api-keys", "{{api_key_id}}"]
        }
      }
    },
    {
      "name": "Use API Key - Search Posts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/post/search?query=developer",
          "host": ["{{base_url}}"],
          "path": ["post", "search"],
          "query": [
            {
              "key": "query",
              "value": "developer"
            }
          ]
        }
      }
    },
    {
      "name": "Use API Key - Get All Posts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/post/get-all-posts",
          "host": ["{{base_url}}"],
          "path": ["post", "get-all-posts"]
        }
      }
    },
    {
      "name": "Use API Key - Create Post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Senior Developer\",\n  \"description\": \"We are looking for a senior developer\",\n  \"salary\": 50000,\n  \"location\": \"Paris\",\n  \"jobType\": \"CDI\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/post/save-post",
          "host": ["{{base_url}}"],
          "path": ["post", "save-post"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "your_jwt_token_here",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "sk_xxx",
      "type": "string"
    },
    {
      "key": "api_key_id",
      "value": "key_id_here",
      "type": "string"
    }
  ]
}
