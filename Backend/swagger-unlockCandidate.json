{
  "openapi": "3.0.0",
  "info": {
    "title": "Unlock Candidate API (fragment)",
    "version": "1.0.0",
    "description": "Fragment OpenAPI for unlock-candidate endpoints"
  },
  "paths": {
    "/unlock-candidate/unlocked": {
      "get": {
        "tags": ["UnlockCandidate"],
        "summary": "Get unlocked candidates",
        "description": "Récupère la liste des candidats débloqués pour la société authentifiée.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Liste des candidats débloqués",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/UnlockCandidate" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/unlock-candidate/all": {
      "get": {
        "tags": ["UnlockCandidate"],
        "summary": "Get all unlock records",
        "description": "Récupère tous les enregistrements de déblocage (pending, etc.) pour la société authentifiée.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Liste des enregistrements de déblocage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/UnlockCandidate" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/unlock-candidate/{unlockId}": {
      "get": {
        "tags": ["UnlockCandidate"],
        "summary": "Get unlock by ID",
        "description": "Récupère un enregistrement de déblocage par son ID.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "unlockId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "ID de l'enregistrement de déblocage"
          }
        ],
        "responses": {
          "200": {
            "description": "Enregistrement trouvé",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/UnlockCandidate" }
                  }
                }
              }
            }
          },
          "404": { "description": "Not found" }
        }
      }
    },
    "/unlock-candidate/create": {
      "post": {
        "tags": ["UnlockCandidate"],
        "summary": "Create unlock record",
        "description": "Crée un enregistrement de déblocage (idCandidate, idJob, unlockPrice)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idCandidate": { "type": "string", "example": "64a1f..." },
                  "idJob": { "type": "string", "example": "64b2g..." },
                  "unlockPrice": { "type": "number", "example": 10 }
                },
                "required": ["idCandidate", "idJob", "unlockPrice"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Bad request" }
        }
      }
    },
    "/unlock-candidate/complete": {
      "post": {
        "tags": ["UnlockCandidate"],
        "summary": "Complete unlock (attach transaction)",
        "description": "Marque le déblocage comme complété en attachant `transactionId`.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "unlockId": { "type": "string" },
                  "transactionId": { "type": "string", "description": "TokenTransaction _id" }
                },
                "required": ["unlockId", "transactionId"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Unlock completed" }, "400": { "description": "Bad request" } }
      }
    },
    "/unlock-candidate/delete": {
      "post": {
        "tags": ["UnlockCandidate"],
        "summary": "Delete unlock record",
        "description": "Supprime un enregistrement de déblocage par ID.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "unlockId": { "type": "string" } },
                "required": ["unlockId"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Deleted" }, "404": { "description": "Not found" } }
      }
    }
  },
  "components": {
    "schemas": {
      "UnlockCandidate": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "idCompany": { "type": "string", "description": "Company user id" },
          "idCandidate": { "type": "object", "description": "Candidate user summary", "properties": { "_id": { "type": "string" }, "firstName": { "type": "string" }, "lastName": { "type": "string" }, "email": { "type": "string" } } },
          "idJob": { "type": "object", "description": "Job summary", "properties": { "_id": { "type": "string" }, "title": { "type": "string" } } },
          "unlockPrice": { "type": "number" },
          "transactionId": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
