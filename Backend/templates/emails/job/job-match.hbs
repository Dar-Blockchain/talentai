<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Job Match</title>
</head>
<body style="margin:0; padding:0; background-color:#F3F4F6; font-family:'Segoe UI', Arial, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F3F4F6; padding:40px 0;">
    <tr>
      <td align="center">
        <table width="560" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 2px 16px rgba(0,0,0,0.07);">

          <!-- Logo -->
          <tr>
            <td style="padding:22px 32px; border-bottom:1px solid #F3F4F6;">
              <img src="cid:logo" alt="TalentAI" height="28" style="display:block; border:0; outline:none;">
            </td>
          </tr>

          <!-- Hero accent bar -->
          <tr>
            <td style="height:4px; background:linear-gradient(90deg,#0D9488,#059669);"></td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:38px 36px 16px 36px;">

              <!-- Pill -->
              <table cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
                <tr>
                  <td style="background-color:#F0FDFA; border:1px solid #99F6E4; border-radius:999px; padding:5px 16px;">
                    <p style="margin:0; font-size:12px; font-weight:700; color:#0D9488; font-family:'Segoe UI', Arial, sans-serif;">🎯 &nbsp;New job match for you</p>
                  </td>
                </tr>
              </table>

              <p style="margin:0 0 10px 0; font-size:23px; font-weight:700; color:#111827; line-height:1.3; font-family:'Segoe UI', Arial, sans-serif;">
                Hi {{candidateName}}, a new role matches your profile!
              </p>
              <p style="margin:0 0 22px 0; font-size:15px; color:#4B5563; line-height:1.75; font-family:'Segoe UI', Arial, sans-serif;">
                Based on your skills and experience, TalentAI found a new opportunity that's a strong fit for your profile. Here are the details:
              </p>

              <!-- Match score highlight -->
              {{#if matchScore}}
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F0FDFA; border-radius:12px; border:1px solid #99F6E4; margin-bottom:22px;">
                <tr>
                  <td style="padding:16px 20px; text-align:center;">
                    <p style="margin:0 0 4px 0; font-size:12px; font-weight:700; color:#0D9488; font-family:'Segoe UI', Arial, sans-serif; text-transform:uppercase; letter-spacing:0.06em;">Profile Match Score</p>
                    <p style="margin:0; font-size:36px; font-weight:800; color:#0D9488; font-family:'Segoe UI', Arial, sans-serif; line-height:1;">{{matchScore}}%</p>
                  </td>
                </tr>
              </table>
              {{/if}}

              <!-- Job details card -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F9FAFB; border-radius:12px; border:1px solid #E5E7EB; margin-bottom:24px;">
                <tr>
                  <td style="padding:22px 24px;">
                    <table width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding-bottom:14px;">
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Position</p>
                          <p style="margin:0; font-size:17px; font-weight:700; color:#111827; font-family:'Segoe UI', Arial, sans-serif;">{{jobTitle}}</p>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding-bottom:14px;">
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Company</p>
                          <p style="margin:0; font-size:15px; font-weight:600; color:#374151; font-family:'Segoe UI', Arial, sans-serif;">{{companyName}}</p>
                        </td>
                      </tr>
                      {{#if experienceLevel}}
                      <tr>
                        <td style="padding-bottom:14px;">
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Experience Level</p>
                          <p style="margin:0; font-size:14px; color:#374151; font-family:'Segoe UI', Arial, sans-serif;">{{experienceLevel}}</p>
                        </td>
                      </tr>
                      {{/if}}
                      {{#if workMode}}
                      <tr>
                        <td style="padding-bottom:14px;">
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Work Mode</p>
                          <p style="margin:0; font-size:14px; color:#374151; font-family:'Segoe UI', Arial, sans-serif;">{{workMode}}</p>
                        </td>
                      </tr>
                      {{/if}}
                      {{#if matchedSkills}}
                      <tr>
                        <td>
                          <p style="margin:0 0 8px 0; font-size:11px; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Your Matching Skills</p>
                          <p style="margin:0; font-size:13px; color:#0D9488; font-weight:600; font-family:'Segoe UI', Arial, sans-serif;">{{matchedSkills}}</p>
                        </td>
                      </tr>
                      {{/if}}
                    </table>
                  </td>
                </tr>
              </table>

              <!-- CTA -->
              <table cellpadding="0" cellspacing="0" style="margin-bottom:14px;">
                <tr>
                  <td style="background-color:#0D9488; border-radius:10px; box-shadow:0 4px 14px rgba(13,148,136,0.28);">
                    <a href="{{jobLink}}" target="_blank" style="display:inline-block; padding:15px 40px; font-size:15px; font-weight:700; color:#ffffff; text-decoration:none; font-family:'Segoe UI', Arial, sans-serif;">
                      View Job & Apply →
                    </a>
                  </td>
                </tr>
              </table>
              <p style="margin:0 0 6px 0; font-size:12px; color:#9CA3AF; font-family:'Segoe UI', Arial, sans-serif;">
                Can't click? Copy this link:<br>
                <a href="{{jobLink}}" style="color:#0D9488; text-decoration:none; word-break:break-all;">{{jobLink}}</a>
              </p>

            </td>
          </tr>

          <!-- Tip bar -->
          <tr>
            <td style="padding:14px 36px; background-color:#FFFBEB; border-top:1px solid #FDE68A;">
              <p style="margin:0 0 4px 0; font-size:12px; font-weight:700; color:#D97706; font-family:'Segoe UI', Arial, sans-serif;">💡 &nbsp;Keep your profile up to date</p>
              <p style="margin:0; font-size:12px; color:#6B7280; line-height:1.7; font-family:'Segoe UI', Arial, sans-serif;">
                The more complete your profile, the better matches you'll receive. Add your latest skills and experience to improve your score.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:18px 36px 24px 36px; border-top:1px solid #F3F4F6;">
              <p style="margin:0 0 4px 0; font-size:12px; color:#9CA3AF; font-family:'Segoe UI', Arial, sans-serif;">
                You're receiving this because your TalentAI profile matches this role's requirements.
              </p>
              <p style="margin:0; font-size:11px; color:#D1D5DB; font-family:'Segoe UI', Arial, sans-serif;">
                &copy; {{year}} TalentAI &nbsp;·&nbsp; This is an automated no-reply email.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
