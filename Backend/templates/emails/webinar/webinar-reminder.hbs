<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{webinarTitle}} — Rappel : demain !</title>
</head>
<body style="margin:0;padding:0;background-color:#f0f4f8;font-family:'Segoe UI',Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f0f4f8;padding:32px 0;">
    <tr>
      <td align="center">
        <table width="620" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.08);">

          <!-- Logo header -->
          <tr>
            <td style="background-color:#ffffff;padding:20px 28px;border-bottom:1px solid #E5E7EB;">
              <img src="cid:logo" alt="TalentAI" height="28" style="display:block;border:0;outline:none;">
            </td>
          </tr>

          <!-- Green accent bar -->
          <tr>
            <td style="height:4px;background:linear-gradient(90deg,#0D9488,#6AD39C);"></td>
          </tr>

          <!-- Hero -->
          <tr>
            <td style="padding:40px 36px 8px 36px;">
              <p style="margin:0 0 6px 0;font-size:12px;font-weight:700;color:#6AD39C;text-transform:uppercase;letter-spacing:1.5px;">
                {{#if isEn}}Reminder{{else}}Rappel{{/if}}
              </p>
              <h1 style="margin:0 0 12px 0;font-size:26px;font-weight:800;color:#0F172A;line-height:1.2;">
                {{#if isEn}}
                  {{nom}}, your webinar is tomorrow! 🗓️
                {{else}}
                  {{nom}}, votre webinar c'est demain ! 🗓️
                {{/if}}
              </h1>
              <p style="margin:0;font-size:15px;color:#64748B;line-height:1.6;">
                {{#if isEn}}
                  Don't forget — your session starts in less than 24 hours. Everything is ready for you.
                {{else}}
                  N'oubliez pas — votre session commence dans moins de 24 heures. Tout est prêt pour vous.
                {{/if}}
              </p>
            </td>
          </tr>

          <!-- Webinar info bar -->
          <tr>
            <td style="padding:24px 36px 0 36px;">
              <table width="100%" cellpadding="0" cellspacing="0" style="background:#F8FAFC;border:1px solid #E2E8F0;border-radius:12px;overflow:hidden;">
                <tr>
                  <td style="padding:16px 20px;">
                    <table cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding-right:28px;">
                          <p style="margin:0;font-size:10px;font-weight:700;color:#94A3B8;text-transform:uppercase;letter-spacing:1px;">Webinar</p>
                          <p style="margin:4px 0 0 0;font-size:14px;font-weight:700;color:#0F172A;">{{webinarTitle}}</p>
                        </td>
                        {{#if webinarDate}}
                        <td style="padding-right:28px;border-left:1px solid #E2E8F0;padding-left:28px;">
                          <p style="margin:0;font-size:10px;font-weight:700;color:#94A3B8;text-transform:uppercase;letter-spacing:1px;">
                            {{#if isEn}}Date{{else}}Date{{/if}}
                          </p>
                          <p style="margin:4px 0 0 0;font-size:14px;font-weight:700;color:#0F172A;">{{webinarDate}}</p>
                        </td>
                        {{/if}}
                        <td style="border-left:1px solid #E2E8F0;padding-left:28px;">
                          <p style="margin:0;font-size:10px;font-weight:700;color:#94A3B8;text-transform:uppercase;letter-spacing:1px;">Format</p>
                          <p style="margin:4px 0 0 0;font-size:14px;font-weight:700;color:#0F172A;">
                            {{#if isEn}}Live session · Free{{else}}Session live · Gratuit{{/if}}
                          </p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- What to expect -->
          <tr>
            <td style="padding:28px 36px 0 36px;">
              <p style="margin:0 0 14px 0;font-size:11px;font-weight:700;color:#94A3B8;text-transform:uppercase;letter-spacing:1.2px;">
                {{#if isEn}}What to expect{{else}}Au programme{{/if}}
              </p>
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="padding-bottom:10px;vertical-align:top;width:28px;">
                    <div style="width:20px;height:20px;border-radius:50%;background:#0D9488;color:#fff;font-size:11px;font-weight:800;text-align:center;line-height:20px;">1</div>
                  </td>
                  <td style="padding-bottom:10px;padding-left:10px;vertical-align:top;">
                    <p style="margin:0;font-size:13px;font-weight:600;color:#0F172A;">
                      {{#if isEn}}Answer the questions (3 min){{else}}Répondez aux questions (3 min){{/if}}
                    </p>
                    <p style="margin:2px 0 0 0;font-size:12px;color:#64748B;">
                      {{#if isEn}}Quick AI-powered assessment of your recruitment maturity.{{else}}Évaluation rapide de votre maturité IA en recrutement.{{/if}}
                    </p>
                  </td>
                </tr>
                <tr>
                  <td style="padding-bottom:10px;vertical-align:top;width:28px;">
                    <div style="width:20px;height:20px;border-radius:50%;background:#6366F1;color:#fff;font-size:11px;font-weight:800;text-align:center;line-height:20px;">2</div>
                  </td>
                  <td style="padding-bottom:10px;padding-left:10px;vertical-align:top;">
                    <p style="margin:0;font-size:13px;font-weight:600;color:#0F172A;">
                      {{#if isEn}}AI analyses your profile{{else}}L'IA analyse votre profil{{/if}}
                    </p>
                    <p style="margin:2px 0 0 0;font-size:12px;color:#64748B;">
                      {{#if isEn}}Your maturity score is calculated instantly.{{else}}Votre score de maturité est calculé instantanément.{{/if}}
                    </p>
                  </td>
                </tr>
                <tr>
                  <td style="vertical-align:top;width:28px;">
                    <div style="width:20px;height:20px;border-radius:50%;background:#F59E0B;color:#fff;font-size:11px;font-weight:800;text-align:center;line-height:20px;">3</div>
                  </td>
                  <td style="padding-left:10px;vertical-align:top;">
                    <p style="margin:0;font-size:13px;font-weight:600;color:#0F172A;">
                      {{#if isEn}}Receive your personalised AI report{{else}}Recevez votre rapport IA personnalisé{{/if}}
                    </p>
                    <p style="margin:2px 0 0 0;font-size:12px;color:#64748B;">
                      {{#if isEn}}Action plan delivered directly to your inbox.{{else}}Plan d'action livré directement dans votre boîte mail.{{/if}}
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td style="padding:28px 36px 0 36px;text-align:center;">
              <a href="{{webinarUrl}}" style="display:inline-block;background:linear-gradient(135deg,#0D9488,#6AD39C);color:#ffffff;text-decoration:none;font-size:15px;font-weight:700;padding:14px 32px;border-radius:12px;letter-spacing:0.3px;">
                {{#if isEn}}Join the webinar →{{else}}Rejoindre le webinar →{{/if}}
              </a>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:32px 36px;text-align:center;border-top:1px solid #F1F5F9;margin-top:28px;">
              <p style="margin:0 0 4px 0;font-size:12px;color:#94A3B8;">TalentAI · Données confidentielles · Aucun spam</p>
              <p style="margin:0;font-size:11px;color:#CBD5E1;">© {{year}} TalentAI. Tous droits réservés.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
