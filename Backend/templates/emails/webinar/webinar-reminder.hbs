<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{webinarTitle}} — {{#if isEn}}Your join link{{else}}Votre lien de connexion{{/if}}</title>
</head>
<body style="margin:0;padding:0;background-color:#f0f4f8;font-family:'Segoe UI',Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f0f4f8;padding:32px 0;">
    <tr>
      <td align="center">
        <table width="620" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.08);">

          <!-- Logo header -->
          <tr>
            <td style="background-color:#ffffff;padding:20px 28px;border-bottom:1px solid #E5E7EB;">
              <img src="cid:logo" alt="TalentAI" height="28" style="display:block;border:0;outline:none;">
            </td>
          </tr>

          <!-- Green accent bar -->
          <tr>
            <td style="height:4px;background:linear-gradient(90deg,#0D9488,#6AD39C);"></td>
          </tr>

          <!-- Hero -->
          <tr>
            <td style="padding:40px 36px 8px 36px;">
              <p style="margin:0 0 6px 0;font-size:12px;font-weight:700;color:#6AD39C;text-transform:uppercase;letter-spacing:1.5px;">
                {{#if isEn}}Webinar link{{else}}Lien webinar{{/if}}
              </p>
              <h1 style="margin:0 0 12px 0;font-size:26px;font-weight:800;color:#0F172A;line-height:1.2;">
                {{#if isEn}}
                  {{nom}}, here is your join link 🎯
                {{else}}
                  {{nom}}, voici votre lien de connexion 🎯
                {{/if}}
              </h1>
              <p style="margin:0;font-size:15px;color:#64748B;line-height:1.6;">
                {{#if isEn}}
                  Everything is ready. Click the button below to join the session at the scheduled time.
                {{else}}
                  Tout est prêt. Cliquez sur le bouton ci-dessous pour rejoindre la session à l'heure prévue.
                {{/if}}
              </p>
            </td>
          </tr>

          <!-- Webinar info bar -->
          <tr>
            <td style="padding:24px 36px 0 36px;">
              <table width="100%" cellpadding="0" cellspacing="0" style="background:#F8FAFC;border:1px solid #E2E8F0;border-radius:12px;overflow:hidden;">
                <tr>
                  <td style="padding:16px 20px;">
                    <table cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding-right:28px;">
                          <p style="margin:0;font-size:10px;font-weight:700;color:#94A3B8;text-transform:uppercase;letter-spacing:1px;">Webinar</p>
                          <p style="margin:4px 0 0 0;font-size:14px;font-weight:700;color:#0F172A;">{{webinarTitle}}</p>
                        </td>
                        {{#if webinarDate}}
                        <td style="padding-right:28px;border-left:1px solid #E2E8F0;padding-left:28px;">
                          <p style="margin:0;font-size:10px;font-weight:700;color:#94A3B8;text-transform:uppercase;letter-spacing:1px;">
                            {{#if isEn}}Date{{else}}Date{{/if}}
                          </p>
                          <p style="margin:4px 0 0 0;font-size:14px;font-weight:700;color:#0F172A;">{{webinarDate}}</p>
                        </td>
                        {{/if}}
                        {{#if webinarTime}}
                        <td style="border-left:1px solid #E2E8F0;padding-left:28px;">
                          <p style="margin:0;font-size:10px;font-weight:700;color:#94A3B8;text-transform:uppercase;letter-spacing:1px;">
                            {{#if isEn}}Time{{else}}Heure{{/if}}
                          </p>
                          <p style="margin:4px 0 0 0;font-size:20px;font-weight:900;color:#0D9488;">{{webinarTime}}</p>
                        </td>
                        {{/if}}
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td style="padding:32px 36px 0 36px;text-align:center;">
              <a href="{{webinarUrl}}" style="display:inline-block;background-color:#0D9488;background:linear-gradient(135deg,#0D9488,#6AD39C);color:#ffffff;text-decoration:none;font-size:15px;font-weight:700;padding:16px 40px;border-radius:12px;letter-spacing:0.3px;mso-padding-alt:0;">
                <!--[if mso]>
                <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{webinarUrl}}" style="height:52px;v-text-anchor:middle;width:260px;" arcsize="20%" fillcolor="#0D9488" stroke="f">
                <w:anchorlock/>
                <center style="color:#ffffff;font-family:'Segoe UI',Arial,sans-serif;font-size:15px;font-weight:700;">{{#if isEn}}Join the webinar &#8594;{{else}}Rejoindre le webinar &#8594;{{/if}}</center>
                </v:roundrect>
                <![endif]-->
                <!--[if !mso]><!-->
                {{#if isEn}}Join the webinar →{{else}}Rejoindre le webinar →{{/if}}
                <!--<![endif]-->
              </a>
            </td>
          </tr>

          <!-- Note -->
          <tr>
            <td style="padding:16px 36px 0 36px;text-align:center;">
              <p style="margin:0;font-size:12px;color:#94A3B8;">
                {{#if isEn}}Keep this link handy — it gives you direct access to the live session.{{else}}Gardez ce lien à portée — il vous donne accès direct à la session en direct.{{/if}}
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:32px 36px;text-align:center;border-top:1px solid #F1F5F9;margin-top:28px;">
              <p style="margin:0 0 4px 0;font-size:12px;color:#94A3B8;">TalentAI · Données confidentielles · Aucun spam</p>
              <p style="margin:0;font-size:11px;color:#CBD5E1;">© {{year}} TalentAI. Tous droits réservés.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
