<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your interview closes tomorrow</title>
</head>
<body style="margin:0; padding:0; background-color:#F3F4F6; font-family:'Segoe UI', Arial, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F3F4F6; padding:40px 0;">
    <tr>
      <td align="center">
        <table width="560" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 2px 16px rgba(0,0,0,0.07);">

          <!-- Logo -->
          <tr>
            <td style="padding:22px 32px; border-bottom:1px solid #F3F4F6;">
              <table cellpadding="0" cellspacing="0" style="background-color:#141415; border-radius:24px; width:110px; height:28px;">
                <tr>
                  <td align="center" valign="middle" style="padding:0 12px;">
                    <img src="cid:logocompany" alt="TalentAI" height="18" style="display:block; border:0; outline:none;">
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Urgent banner -->
          <tr>
            <td style="background-color:#FEF2F2; padding:13px 32px; border-bottom:1px solid #FECACA;">
              <p style="margin:0; font-size:13px; font-weight:700; color:#DC2626; text-align:center; font-family:'Segoe UI', Arial, sans-serif;">
                ⚠️ &nbsp;Less than 24 hours left — your interview closes soon
              </p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:36px 36px 16px 36px;">

              <p style="margin:0 0 10px 0; font-size:23px; font-weight:700; color:#111827; line-height:1.3; font-family:'Segoe UI', Arial, sans-serif;">
                You've come this far, {{firstName}} — don't stop now
              </p>
              <p style="margin:0 0 22px 0; font-size:15px; color:#4B5563; line-height:1.75; font-family:'Segoe UI', Arial, sans-serif;">
                Your AI interview for <strong style="color:#111827;">{{jobTitle}}</strong> at <strong style="color:#111827;">{{companyName}}</strong> is about to close. You applied, you made it through — the only thing standing between you and a complete application is about 20 minutes.
              </p>

              <!-- Clarification box -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#EFF6FF; border-radius:12px; border:1px solid #BFDBFE; margin-bottom:22px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0 0 6px 0; font-size:13px; font-weight:700; color:#1D4ED8; font-family:'Segoe UI', Arial, sans-serif;">🤖 &nbsp;No call, no meeting — just click and start</p>
                    <p style="margin:0; font-size:13px; color:#1E40AF; line-height:1.65; font-family:'Segoe UI', Arial, sans-serif;">
                      This is a fully on-demand AI interview. There's no one waiting on the other side, no scheduling needed. Open the link and the AI will ask you questions at your own pace. You can do this right now, in the next 20 minutes.
                    </p>
                  </td>
                </tr>
              </table>

              <!-- Deadline box -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#FEF2F2; border-radius:12px; border:1.5px solid #FECACA; margin-bottom:22px;">
                <tr>
                  <td style="padding:18px 24px; text-align:center;">
                    <p style="margin:0 0 5px 0; font-size:11px; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:1px; font-family:'Segoe UI', Arial, sans-serif;">Application deadline</p>
                    <p style="margin:0; font-size:22px; font-weight:800; color:#DC2626; font-family:'Segoe UI', Arial, sans-serif;">{{deadline}}</p>
                    <p style="margin:6px 0 0 0; font-size:12px; color:#EF4444; font-family:'Segoe UI', Arial, sans-serif;">After this date, your application will no longer be reviewed.</p>
                  </td>
                </tr>
              </table>

              <!-- What to prepare -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F9FAFB; border-radius:12px; margin-bottom:30px;">
                <tr>
                  <td style="padding:18px 24px;">
                    <p style="margin:0 0 10px 0; font-size:13px; font-weight:700; color:#374151; font-family:'Segoe UI', Arial, sans-serif;">Before you start — a quick checklist</p>
                    <p style="margin:0 0 6px 0; font-size:13px; color:#6B7280; font-family:'Segoe UI', Arial, sans-serif;">📷 &nbsp;Camera &amp; microphone working</p>
                    <p style="margin:0 0 6px 0; font-size:13px; color:#6B7280; font-family:'Segoe UI', Arial, sans-serif;">🤫 &nbsp;Quiet place with a few minutes of focus</p>
                    <p style="margin:0 0 6px 0; font-size:13px; color:#6B7280; font-family:'Segoe UI', Arial, sans-serif;">🌐 &nbsp;Stable internet connection</p>
                    <p style="margin:0; font-size:13px; color:#6B7280; font-family:'Segoe UI', Arial, sans-serif;">⏱ &nbsp;~20 uninterrupted minutes — that's all it takes</p>
                  </td>
                </tr>
              </table>

              <!-- CTA -->
              <table cellpadding="0" cellspacing="0" style="margin-bottom:14px;">
                <tr>
                  <td style="background-color:#DC2626; border-radius:10px; box-shadow:0 4px 14px rgba(220,38,38,0.28);">
                    <a href="{{interviewLink}}" target="_blank" style="display:inline-block; padding:15px 40px; font-size:15px; font-weight:700; color:#ffffff; text-decoration:none; font-family:'Segoe UI', Arial, sans-serif;">
                      Complete My Interview Now →
                    </a>
                  </td>
                </tr>
              </table>
              <p style="margin:0 0 6px 0; font-size:12px; color:#9CA3AF; font-family:'Segoe UI', Arial, sans-serif;">
                Or copy this link into your browser:<br>
                <a href="{{interviewLink}}" style="color:#DC2626; text-decoration:none; word-break:break-all;">{{interviewLink}}</a>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:18px 36px 24px 36px; border-top:1px solid #F3F4F6;">
              <p style="margin:0 0 4px 0; font-size:12px; color:#9CA3AF; font-family:'Segoe UI', Arial, sans-serif;">
                Final reminder for your <strong>{{jobTitle}}</strong> application at <strong>{{companyName}}</strong>. No further reminders will be sent after this.
              </p>
              <p style="margin:0; font-size:11px; color:#D1D5DB; font-family:'Segoe UI', Arial, sans-serif;">
                &copy; {{year}} TalentAI &nbsp;·&nbsp; <a href="mailto:contact@talentai.bid" style="color:#0D9488; text-decoration:none;">contact@talentai.bid</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
