<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Entretien candidat terminé</title>
</head>
<body style="margin:0; padding:0; background-color:#f0f4f8; font-family:'Segoe UI', Arial, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f0f4f8; padding:32px 0;">
    <tr>
      <td align="center">
        <table width="620" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 4px 24px rgba(0,0,0,0.08);">

          <!-- Logo header -->
          <tr>
            <td style="background-color:#ffffff; padding:20px 28px; border-bottom:1px solid #E5E7EB;">
              <img src="cid:logo" alt="TalentAI" height="28" style="display:block; border:0; outline:none;">
            </td>
          </tr>

          <!-- Title -->
          <tr>
            <td style="padding:36px 36px 8px 36px;">
              <h1 style="margin:0; font-size:30px; font-weight:700; color:#4F5A68; line-height:1.2; font-family:'Segoe UI', Arial, sans-serif;">
                Entretien terminé
              </h1>
            </td>
          </tr>

          <!-- Body text -->
          <tr>
            <td style="padding:20px 36px 0 36px;">
              <p style="margin:0 0 10px 0; font-size:16px; color:#4F5A68; font-family:'Segoe UI', Arial, sans-serif;">Bonjour {{companyName}},</p>
              <p style="margin:0; font-size:16px; color:#4F5A68; line-height:1.6; font-family:'Segoe UI', Arial, sans-serif;">
                Un candidat a terminé avec succès son évaluation d'entretien. Vous pouvez désormais consulter ses réponses et ses scores d'évaluation dans le tableau de bord TalentAI.
              </p>
            </td>
          </tr>

          <!-- Alert badge -->
          <tr>
            <td style="padding:24px 36px 8px 36px;">
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="background-color:#fffbeb; border:1.5px solid #fcd34d; border-radius:10px; padding:14px 24px;">
                    <p style="margin:0; font-size:15px; font-weight:700; color:#d97706; font-family:'Segoe UI', Arial, sans-serif;">
                      ⚡ &nbsp;Nouvelle évaluation prête à examiner
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Details box -->
          <tr>
            <td style="padding:16px 36px 8px 36px;">
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f9fafb; border-radius:10px; border:1px solid #e5e7eb;">
                <tr>
                  <td style="padding:20px 24px;">
                    <table width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding-bottom:14px;">
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Poste</p>
                          <p style="margin:0; font-size:15px; font-weight:700; color:#4F5A68; font-family:'Segoe UI', Arial, sans-serif;">{{postTitle}}</p>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding-bottom:14px;">
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Candidat</p>
                          <p style="margin:0; font-size:15px; font-weight:700; color:#4F5A68; font-family:'Segoe UI', Arial, sans-serif;">{{candidateName}}</p>
                        </td>
                      </tr>
                      <tr>
                        <td>
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">E-mail</p>
                          <p style="margin:0; font-size:14px; color:#0ea5a0; font-family:'Segoe UI', Arial, sans-serif;">{{candidateEmail}}</p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- CTA Button -->
          <tr>
            <td align="center" style="padding:24px 36px 28px 36px;">
              <table cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="background-color:#0ea5a0; border-radius:8px;">
                    <a href="https://app.talentai.bid/dashboard/interviews" target="_blank" style="display:inline-block; padding:14px 36px; font-size:15px; font-weight:700; color:#ffffff; text-decoration:none; font-family:'Segoe UI', Arial, sans-serif;">
                      Voir les résultats
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding:0 36px;">
              <hr style="border:none; border-top:1px solid #e5e7eb; margin:0;">
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color:#f9fafb; padding:20px 36px; border-radius:0 0 12px 12px;">
              <p style="margin:0; font-size:13px; color:#6b7280; font-family:'Segoe UI', Arial, sans-serif;">
                Ceci est un e-mail automatique sans réponse — veuillez ne pas répondre à ce message.
              </p>
              <p style="margin:10px 0 0 0; font-size:12px; color:#9ca3af; font-family:'Segoe UI', Arial, sans-serif;">
                &copy; {{year}} TalentAI. Tous droits réservés.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
