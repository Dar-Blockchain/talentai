<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Interview Invitation</title>
</head>
<body style="margin:0; padding:0; background-color:#F3F4F6; font-family:'Segoe UI', Arial, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F3F4F6; padding:40px 0;">
    <tr>
      <td align="center">
        <table width="560" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 2px 16px rgba(0,0,0,0.07);">

          <!-- Logo -->
          <tr>
            <td style="padding:22px 32px; border-bottom:1px solid #F3F4F6;">
              <table cellpadding="0" cellspacing="0" style="background-color:#141415; border-radius:24px; width:110px; height:28px;">
                <tr>
                  <td align="center" valign="middle" style="padding:0 12px;">
                    <img src="cid:logocompany" alt="TalentAI" height="18" style="display:block; border:0; outline:none;">
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:38px 36px 16px 36px;">

              <!-- Pill -->
              <table cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
                <tr>
                  <td style="background-color:#F0FDFA; border:1px solid #99F6E4; border-radius:999px; padding:5px 16px;">
                    <p style="margin:0; font-size:12px; font-weight:700; color:#0D9488; font-family:'Segoe UI', Arial, sans-serif;">🎉 &nbsp;You've been selected</p>
                  </td>
                </tr>
              </table>

              <p style="margin:0 0 10px 0; font-size:23px; font-weight:700; color:#111827; line-height:1.3; font-family:'Segoe UI', Arial, sans-serif;">
                Hi {{candidateName}}, you're invited to an AI interview!
              </p>
              <p style="margin:0 0 22px 0; font-size:15px; color:#4B5563; line-height:1.75; font-family:'Segoe UI', Arial, sans-serif;">
                <strong style="color:#111827;">{{companyName}}</strong> has reviewed your profile and selected you to move forward for <strong style="color:#111827;">{{jobTitle}}</strong>. The next step is a short AI interview — completely on-demand, no scheduling required.
              </p>

              <!-- Key callout: NOT a meeting -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#EFF6FF; border-radius:12px; border:1px solid #BFDBFE; margin-bottom:22px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0 0 6px 0; font-size:13px; font-weight:700; color:#1D4ED8; font-family:'Segoe UI', Arial, sans-serif;">🤖 &nbsp;Not a meeting — an on-demand AI interview</p>
                    <p style="margin:0; font-size:13px; color:#1E40AF; line-height:1.65; font-family:'Segoe UI', Arial, sans-serif;">
                      You won't be joining a video call or waiting for a recruiter. There is no Google Meet, no Zoom, no fixed appointment. Just click your personal link below and an AI agent will guide you through a set of questions at your own pace — start whenever you're ready, before the deadline.
                    </p>
                  </td>
                </tr>
              </table>

              <!-- Quick facts -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F9FAFB; border-radius:12px; margin-bottom:22px;">
                <tr>
                  <td style="padding:20px 24px;">
                    <table width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td width="50%" style="text-align:center; padding:4px 8px; border-right:1px solid #E5E7EB;">
                          <p style="margin:0 0 5px 0; font-size:22px;">🗓</p>
                          <p style="margin:0 0 2px 0; font-size:12px; font-weight:700; color:#374151; font-family:'Segoe UI', Arial, sans-serif;">Any time</p>
                          <p style="margin:0; font-size:11px; color:#9CA3AF; font-family:'Segoe UI', Arial, sans-serif;">before the deadline</p>
                        </td>
                        <td width="50%" style="text-align:center; padding:4px 8px;">
                          <p style="margin:0 0 5px 0; font-size:22px;">🎙</p>
                          <p style="margin:0 0 2px 0; font-size:12px; font-weight:700; color:#374151; font-family:'Segoe UI', Arial, sans-serif;">Camera & mic</p>
                          <p style="margin:0; font-size:11px; color:#9CA3AF; font-family:'Segoe UI', Arial, sans-serif;">needed for the session</p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Interview details -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f9fafb; border-radius:10px; border:1px solid #e5e7eb; margin-bottom:24px;">
                <tr>
                  <td style="padding:20px 24px;">
                    <table width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding-bottom:14px;">
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Position</p>
                          <p style="margin:0; font-size:15px; font-weight:700; color:#111827; font-family:'Segoe UI', Arial, sans-serif;">{{jobTitle}}</p>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding-bottom:14px;">
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Company</p>
                          <p style="margin:0; font-size:15px; font-weight:700; color:#111827; font-family:'Segoe UI', Arial, sans-serif;">{{companyName}}</p>
                        </td>
                      </tr>
                      {{#if interviewDate}}
                      <tr>
                        <td>
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Deadline</p>
                          <p style="margin:0; font-size:15px; font-weight:700; color:#DC2626; font-family:'Segoe UI', Arial, sans-serif;">{{interviewDate}}</p>
                        </td>
                      </tr>
                      {{/if}}
                    </table>
                  </td>
                </tr>
              </table>

              <!-- CTA -->
              {{#if interviewLink}}
              <table cellpadding="0" cellspacing="0" style="margin-bottom:14px;">
                <tr>
                  <td style="background-color:#0D9488; border-radius:10px; box-shadow:0 4px 14px rgba(13,148,136,0.28);">
                    <a href="{{interviewLink}}" target="_blank" style="display:inline-block; padding:15px 40px; font-size:15px; font-weight:700; color:#ffffff; text-decoration:none; font-family:'Segoe UI', Arial, sans-serif;">
                      Start My AI Interview →
                    </a>
                  </td>
                </tr>
              </table>
              <p style="margin:0 0 6px 0; font-size:12px; color:#9CA3AF; font-family:'Segoe UI', Arial, sans-serif;">
                Can't click? Copy this link into your browser:<br>
                <a href="{{interviewLink}}" style="color:#0D9488; text-decoration:none; word-break:break-all;">{{interviewLink}}</a>
              </p>
              {{/if}}

            </td>
          </tr>

          <!-- Tip bar -->
          <tr>
            <td style="padding:14px 36px; background-color:#FFFBEB; border-top:1px solid #FDE68A;">
              <p style="margin:0 0 4px 0; font-size:12px; font-weight:700; color:#D97706; font-family:'Segoe UI', Arial, sans-serif;">📋 &nbsp;Before you begin</p>
              <p style="margin:0; font-size:12px; color:#6B7280; line-height:1.7; font-family:'Segoe UI', Arial, sans-serif;">
                Use a laptop or desktop &nbsp;·&nbsp; Find a quiet, well-lit spot &nbsp;·&nbsp; Stable internet required &nbsp;·&nbsp; Complete in one sitting once started
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:18px 36px 24px 36px; border-top:1px solid #F3F4F6;">
              <p style="margin:0 0 4px 0; font-size:12px; color:#9CA3AF; font-family:'Segoe UI', Arial, sans-serif;">
                You received this because you applied for <strong>{{jobTitle}}</strong> at <strong>{{companyName}}</strong>.
              </p>
              <p style="margin:0; font-size:11px; color:#D1D5DB; font-family:'Segoe UI', Arial, sans-serif;">
                &copy; {{year}} TalentAI &nbsp;·&nbsp; This is an automated no-reply email.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
