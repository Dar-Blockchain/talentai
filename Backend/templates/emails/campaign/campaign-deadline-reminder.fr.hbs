<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rappel de date limite de campagne</title>
</head>
<body style="margin:0; padding:0; background-color:#F3F4F6; font-family:'Segoe UI', Arial, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F3F4F6; padding:40px 0;">
    <tr>
      <td align="center">
        <table width="560" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 2px 16px rgba(0,0,0,0.07);">

          <!-- Logo -->
          <tr>
            <td style="padding:22px 32px; border-bottom:1px solid #F3F4F6;">
              <img src="cid:logo" alt="TalentAI" height="28" style="display:block; border:0; outline:none;">
            </td>
          </tr>

          <!-- Urgent banner -->
          <tr>
            <td style="background-color:#FEF2F2; padding:13px 32px; border-bottom:1px solid #FECACA;">
              <p style="margin:0; font-size:13px; font-weight:700; color:#DC2626; text-align:center; font-family:'Segoe UI', Arial, sans-serif;">
                ⏰ &nbsp;Date limite approchante — {{hoursLeft}} heures restantes pour compléter votre évaluation
              </p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:36px 36px 16px 36px;">

              <p style="margin:0 0 10px 0; font-size:23px; font-weight:700; color:#111827; line-height:1.3; font-family:'Segoe UI', Arial, sans-serif;">
                Ne manquez pas votre date limite, {{participantName}}
              </p>
              <p style="margin:0 0 22px 0; font-size:15px; color:#4B5563; line-height:1.75; font-family:'Segoe UI', Arial, sans-serif;">
                Vous avez été assigné(e) à la campagne <strong style="color:#111827;">{{campaignTitle}}</strong> par <strong style="color:#111827;">{{companyName}}</strong>. La date limite approche et votre évaluation est toujours en attente — cela ne prend que quelques minutes à compléter.
              </p>

              <!-- Campaign detail box -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f9fafb; border-radius:10px; border:1px solid #e5e7eb; margin-bottom:20px;">
                <tr>
                  <td style="padding:20px 24px;">
                    <table width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding-bottom:12px;">
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Campagne</p>
                          <p style="margin:0; font-size:14px; font-weight:700; color:#111827; font-family:'Segoe UI', Arial, sans-serif;">{{campaignTitle}}</p>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding-bottom:12px;">
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Type d'évaluation</p>
                          <p style="margin:0; font-size:14px; font-weight:700; color:#111827; font-family:'Segoe UI', Arial, sans-serif;">{{moduleLabel}}</p>
                        </td>
                      </tr>
                      <tr>
                        <td>
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Organisé par</p>
                          <p style="margin:0; font-size:14px; font-weight:700; color:#111827; font-family:'Segoe UI', Arial, sans-serif;">{{companyName}}</p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Deadline box -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#FEF2F2; border-radius:12px; border:1.5px solid #FECACA; margin-bottom:22px;">
                <tr>
                  <td style="padding:18px 24px; text-align:center;">
                    <p style="margin:0 0 5px 0; font-size:11px; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:1px; font-family:'Segoe UI', Arial, sans-serif;">Date limite de l'évaluation</p>
                    <p style="margin:0; font-size:22px; font-weight:800; color:#DC2626; font-family:'Segoe UI', Arial, sans-serif;">{{deadline}}</p>
                    <p style="margin:6px 0 0 0; font-size:12px; color:#EF4444; font-family:'Segoe UI', Arial, sans-serif;">Après cette date, votre soumission ne sera plus acceptée.</p>
                  </td>
                </tr>
              </table>

              <!-- Tips -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F9FAFB; border-radius:12px; margin-bottom:28px;">
                <tr>
                  <td style="padding:18px 24px;">
                    <p style="margin:0 0 10px 0; font-size:13px; font-weight:700; color:#374151; font-family:'Segoe UI', Arial, sans-serif;">Avant de commencer</p>
                    <p style="margin:0 0 6px 0; font-size:13px; color:#6B7280; font-family:'Segoe UI', Arial, sans-serif;">🌐 &nbsp;Connexion internet stable</p>
                    <p style="margin:0 0 6px 0; font-size:13px; color:#6B7280; font-family:'Segoe UI', Arial, sans-serif;">🤫 &nbsp;Trouvez un endroit calme avec quelques minutes de concentration</p>
                    <p style="margin:0; font-size:13px; color:#6B7280; font-family:'Segoe UI', Arial, sans-serif;">📷 &nbsp;Pour les entretiens IA : caméra et microphone requis</p>
                  </td>
                </tr>
              </table>

              <!-- CTA -->
              <table cellpadding="0" cellspacing="0" style="margin-bottom:14px;">
                <tr>
                  <td bgcolor="#DC2626" style="background-color:#DC2626; border-radius:10px;">
                    <a href="{{assessmentLink}}" target="_blank" style="display:inline-block; padding:15px 40px; font-size:15px; font-weight:700; color:#ffffff; text-decoration:none; font-family:'Segoe UI', Arial, sans-serif; background-color:#DC2626; border-radius:10px;">
                      Terminer mon évaluation maintenant &#8594;
                    </a>
                  </td>
                </tr>
              </table>
              <p style="margin:0 0 6px 0; font-size:12px; color:#9CA3AF; font-family:'Segoe UI', Arial, sans-serif;">
                Ou copiez ce lien dans votre navigateur :<br>
                <a href="{{assessmentLink}}" style="color:#DC2626; text-decoration:none; word-break:break-all;">{{assessmentLink}}</a>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:18px 36px 24px 36px; border-top:1px solid #F3F4F6;">
              <p style="margin:0 0 4px 0; font-size:12px; color:#9CA3AF; font-family:'Segoe UI', Arial, sans-serif;">
                Rappel pour la campagne <strong>{{campaignTitle}}</strong> par <strong>{{companyName}}</strong>. Si vous n'attendiez pas ce message, veuillez l'ignorer.
              </p>
              <p style="margin:0; font-size:11px; color:#D1D5DB; font-family:'Segoe UI', Arial, sans-serif;">
                &copy; {{year}} TalentAI &nbsp;·&nbsp; Ceci est un e-mail automatique sans réponse.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
