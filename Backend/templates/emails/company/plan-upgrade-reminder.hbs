<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upgrade Your TalentAI Plan</title>
</head>
<body style="margin:0; padding:0; background-color:#F3F4F6; font-family:'Segoe UI', Arial, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F3F4F6; padding:40px 0;">
    <tr>
      <td align="center">
        <table width="560" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 2px 16px rgba(0,0,0,0.07);">

          <!-- Header -->
          <tr>
            <td style="background:linear-gradient(135deg,#0D9488,#0891B2); padding:36px 40px; text-align:center;">
              <table cellpadding="0" cellspacing="0" style="margin:0 auto 16px auto; background-color:#141415; border-radius:24px; width:110px; height:28px;">
                <tr>
                  <td align="center" valign="middle" style="padding:0 12px;">
                    <img src="cid:logocompany" alt="TalentAI" height="18" style="display:block; border:0; outline:none;">
                  </td>
                </tr>
              </table>
              <h1 style="margin:0; font-size:22px; font-weight:700; color:#ffffff; font-family:'Segoe UI', Arial, sans-serif;">Your plan needs an upgrade</h1>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:36px 40px 24px 40px;">

              <p style="margin:0 0 14px 0; font-size:15px; color:#374151; font-family:'Segoe UI', Arial, sans-serif;">
                Hi <strong>{{companyName}}</strong>,
              </p>
              <p style="margin:0 0 22px 0; font-size:14px; color:#6B7280; line-height:1.75; font-family:'Segoe UI', Arial, sans-serif;">
                Your company is currently on a <strong>Trial</strong> plan. To continue posting jobs, running AI interviews, and accessing candidate matching, you'll need to upgrade to a paid plan.
              </p>

              <!-- Benefits box -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F0FDF4; border:1px solid #BBF7D0; border-radius:10px; margin-bottom:28px;">
                <tr>
                  <td style="padding:20px 24px;">
                    <p style="margin:0 0 10px 0; font-size:14px; font-weight:600; color:#065F46; font-family:'Segoe UI', Arial, sans-serif;">✅ &nbsp;What you unlock with a paid plan:</p>
                    <p style="margin:0 0 6px 0; font-size:13px; color:#374151; font-family:'Segoe UI', Arial, sans-serif;">• More job posts &amp; monthly interviews</p>
                    <p style="margin:0 0 6px 0; font-size:13px; color:#374151; font-family:'Segoe UI', Arial, sans-serif;">• Priority candidate matching</p>
                    <p style="margin:0; font-size:13px; color:#374151; font-family:'Segoe UI', Arial, sans-serif;">• Advanced analytics &amp; reporting</p>
                  </td>
                </tr>
              </table>

              <!-- CTA -->
              <table cellpadding="0" cellspacing="0" style="margin:0 auto 28px auto;">
                <tr>
                  <td align="center" style="background:linear-gradient(135deg,#0D9488,#0891B2); border-radius:10px; box-shadow:0 4px 14px rgba(13,148,136,0.28);">
                    <a href="{{upgradeUrl}}" target="_blank" style="display:inline-block; padding:14px 36px; font-size:15px; font-weight:700; color:#ffffff; text-decoration:none; font-family:'Segoe UI', Arial, sans-serif;">
                      View Plans &amp; Upgrade →
                    </a>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:18px 40px 24px 40px; border-top:1px solid #F3F4F6;">
              <p style="margin:0; font-size:11px; color:#D1D5DB; text-align:center; font-family:'Segoe UI', Arial, sans-serif;">
                &copy; {{year}} TalentAI &nbsp;·&nbsp; This is an automated no-reply email.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
