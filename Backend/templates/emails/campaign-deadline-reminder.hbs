<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Campaign deadline reminder</title>
</head>
<body style="margin:0; padding:0; background-color:#F3F4F6; font-family:'Segoe UI', Arial, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F3F4F6; padding:40px 0;">
    <tr>
      <td align="center">
        <table width="560" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 2px 16px rgba(0,0,0,0.07);">

          <!-- Logo -->
          <tr>
            <td style="padding:22px 32px; border-bottom:1px solid #F3F4F6;">
              <table cellpadding="0" cellspacing="0" style="background-color:#141415; border-radius:24px; width:110px; height:28px;">
                <tr>
                  <td align="center" valign="middle" style="padding:0 12px;">
                    <img src="cid:logocompany" alt="TalentAI" height="18" style="display:block; border:0; outline:none;">
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Urgent banner -->
          <tr>
            <td style="background-color:#FEF2F2; padding:13px 32px; border-bottom:1px solid #FECACA;">
              <p style="margin:0; font-size:13px; font-weight:700; color:#DC2626; text-align:center; font-family:'Segoe UI', Arial, sans-serif;">
                ⏰ &nbsp;Deadline approaching — {{hoursLeft}} hours left to complete your assessment
              </p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:36px 36px 16px 36px;">

              <p style="margin:0 0 10px 0; font-size:23px; font-weight:700; color:#111827; line-height:1.3; font-family:'Segoe UI', Arial, sans-serif;">
                Don't miss your deadline, {{participantName}}
              </p>
              <p style="margin:0 0 22px 0; font-size:15px; color:#4B5563; line-height:1.75; font-family:'Segoe UI', Arial, sans-serif;">
                You've been assigned to the <strong style="color:#111827;">{{campaignTitle}}</strong> campaign by <strong style="color:#111827;">{{companyName}}</strong>. The deadline is approaching and your assessment is still pending — it only takes a few minutes to complete.
              </p>

              <!-- Campaign detail box -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f9fafb; border-radius:10px; border:1px solid #e5e7eb; margin-bottom:20px;">
                <tr>
                  <td style="padding:20px 24px;">
                    <table width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding-bottom:12px;">
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Campaign</p>
                          <p style="margin:0; font-size:14px; font-weight:700; color:#111827; font-family:'Segoe UI', Arial, sans-serif;">{{campaignTitle}}</p>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding-bottom:12px;">
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Assessment type</p>
                          <p style="margin:0; font-size:14px; font-weight:700; color:#111827; font-family:'Segoe UI', Arial, sans-serif;">{{moduleLabel}}</p>
                        </td>
                      </tr>
                      <tr>
                        <td>
                          <p style="margin:0 0 3px 0; font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Organised by</p>
                          <p style="margin:0; font-size:14px; font-weight:700; color:#111827; font-family:'Segoe UI', Arial, sans-serif;">{{companyName}}</p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Deadline box -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#FEF2F2; border-radius:12px; border:1.5px solid #FECACA; margin-bottom:22px;">
                <tr>
                  <td style="padding:18px 24px; text-align:center;">
                    <p style="margin:0 0 5px 0; font-size:11px; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:1px; font-family:'Segoe UI', Arial, sans-serif;">Assessment deadline</p>
                    <p style="margin:0; font-size:22px; font-weight:800; color:#DC2626; font-family:'Segoe UI', Arial, sans-serif;">{{deadline}}</p>
                    <p style="margin:6px 0 0 0; font-size:12px; color:#EF4444; font-family:'Segoe UI', Arial, sans-serif;">After this date, your submission will no longer be accepted.</p>
                  </td>
                </tr>
              </table>

              <!-- Tips -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F9FAFB; border-radius:12px; margin-bottom:28px;">
                <tr>
                  <td style="padding:18px 24px;">
                    <p style="margin:0 0 10px 0; font-size:13px; font-weight:700; color:#374151; font-family:'Segoe UI', Arial, sans-serif;">Before you start</p>
                    <p style="margin:0 0 6px 0; font-size:13px; color:#6B7280; font-family:'Segoe UI', Arial, sans-serif;">🌐 &nbsp;Stable internet connection</p>
                    <p style="margin:0 0 6px 0; font-size:13px; color:#6B7280; font-family:'Segoe UI', Arial, sans-serif;">🤫 &nbsp;Find a quiet place with a few minutes of focus</p>
                    <p style="margin:0; font-size:13px; color:#6B7280; font-family:'Segoe UI', Arial, sans-serif;">📷 &nbsp;For AI interviews: camera &amp; microphone required</p>
                  </td>
                </tr>
              </table>

              <!-- CTA -->
              <table cellpadding="0" cellspacing="0" style="margin-bottom:14px;">
                <tr>
                  <td bgcolor="#DC2626" style="background-color:#DC2626; border-radius:10px;">
                    <a href="{{assessmentLink}}" target="_blank" style="display:inline-block; padding:15px 40px; font-size:15px; font-weight:700; color:#ffffff; text-decoration:none; font-family:'Segoe UI', Arial, sans-serif; background-color:#DC2626; border-radius:10px;">
                      Complete My Assessment Now &#8594;
                    </a>
                  </td>
                </tr>
              </table>
              <p style="margin:0 0 6px 0; font-size:12px; color:#9CA3AF; font-family:'Segoe UI', Arial, sans-serif;">
                Or copy this link into your browser:<br>
                <a href="{{assessmentLink}}" style="color:#DC2626; text-decoration:none; word-break:break-all;">{{assessmentLink}}</a>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:18px 36px 24px 36px; border-top:1px solid #F3F4F6;">
              <p style="margin:0 0 4px 0; font-size:12px; color:#9CA3AF; font-family:'Segoe UI', Arial, sans-serif;">
                Reminder for the <strong>{{campaignTitle}}</strong> campaign by <strong>{{companyName}}</strong>. If you did not expect this message, please ignore it.
              </p>
              <p style="margin:0; font-size:11px; color:#D1D5DB; font-family:'Segoe UI', Arial, sans-serif;">
                &copy; {{year}} TalentAI &nbsp;·&nbsp; <a href="mailto:contact@talentai.bid" style="color:#7C3AED; text-decoration:none;">contact@talentai.bid</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
