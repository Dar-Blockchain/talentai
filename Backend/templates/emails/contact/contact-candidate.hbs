<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{subject}}</title>
</head>
<body style="margin:0; padding:0; background-color:#F3F4F6; font-family:'Segoe UI', Arial, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F3F4F6; padding:40px 0;">
    <tr>
      <td align="center">
        <table width="560" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 2px 16px rgba(0,0,0,0.07);">
          <!-- Logo header -->
          <tr>
            <td style="padding:22px 32px; border-bottom:1px solid #F3F4F6;">
              <img src="cid:logo" alt="TalentAI" height="28" style="display:block; border:0; outline:none;">
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:36px 32px 28px 32px;">

              <!-- Company name -->
              <p style="margin:0 0 4px 0; font-size:12px; font-weight:600; color:#9CA3AF; letter-spacing:0.6px; text-transform:uppercase; font-family:'Segoe UI', Arial, sans-serif;">
                {{{t.from_label}}}
              </p>
              <p style="margin:0 0 20px 0; font-size:20px; font-weight:700; color:#111827; font-family:'Segoe UI', Arial, sans-serif;">
                {{companyName}}
              </p>

              <!-- Subject -->
              <p style="margin:0 0 20px 0; font-size:17px; font-weight:600; color:#374151; font-family:'Segoe UI', Arial, sans-serif;">
                {{{t.subject_label}}} {{subject}}
              </p>

              <!-- Divider -->
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
                <tr>
                  <td style="height:1px; background-color:#F3F4F6;"></td>
                </tr>
              </table>

              <!-- Message body -->
              <p style="margin:0; font-size:15px; color:#374151; line-height:1.8; white-space:pre-wrap; font-family:'Segoe UI', Arial, sans-serif;">{{message}}</p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:20px 32px 24px 32px; border-top:1px solid #F3F4F6;">
              <p style="margin:0; font-size:11px; color:#D1D5DB; font-family:'Segoe UI', Arial, sans-serif;">
                &copy; {{year}} {{{t.copyright}}}
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
