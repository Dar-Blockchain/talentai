<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Message from {{companyName}}</title>
</head>
<body style="margin:0; padding:0; background-color:#f0f4f8; font-family:'Segoe UI', Arial, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f0f4f8; padding:32px 0;">
    <tr>
      <td align="center">
        <table width="620" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 4px 24px rgba(0,0,0,0.08);">

          <!-- Logo header -->
          <tr>
            <td style="background-color:#ffffff; padding:20px 28px; border-bottom:1px solid #E5E7EB;">
              <table cellpadding="0" cellspacing="0" style="background-color:#141415; border-radius:24px; width:115px; height:30px;">
                <tr>
                  <td align="center" valign="middle" style="padding:0 12px;">
                    <img src="cid:logocompany" alt="TalentAI" height="20" style="display:block; margin:0 auto; border:0; outline:none;">
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Title -->
          <tr>
            <td style="padding:36px 36px 8px 36px;">
              <h1 style="margin:0; font-size:28px; font-weight:700; color:#4F5A68; line-height:1.2; font-family:'Segoe UI', Arial, sans-serif;">
                You have a new message
              </h1>
            </td>
          </tr>

          <!-- Greeting -->
          <tr>
            <td style="padding:16px 36px 0 36px;">
              <p style="margin:0; font-size:16px; color:#4F5A68; font-family:'Segoe UI', Arial, sans-serif;">
                Hello <strong>{{candidateName}}</strong>,
              </p>
              <p style="margin:10px 0 0 0; font-size:15px; color:#6B7280; line-height:1.6; font-family:'Segoe UI', Arial, sans-serif;">
                <strong>{{companyName}}</strong> has sent you the following message regarding your application on TalentAI.
              </p>
            </td>
          </tr>

          <!-- Sender badge -->
          <tr>
            <td style="padding:20px 36px 8px 36px;">
              <table cellpadding="0" cellspacing="0">
                <tr>
                  <td style="background-color:#F0FDFA; border:1.5px solid #99F6E4; border-radius:8px; padding:10px 18px;">
                    <p style="margin:0; font-size:13px; font-weight:700; color:#0D9488; font-family:'Segoe UI', Arial, sans-serif;">
                      ✉️ &nbsp;From: {{companyName}}
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Subject -->
          <tr>
            <td style="padding:16px 36px 4px 36px;">
              <p style="margin:0 0 4px 0; font-size:11px; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Subject</p>
              <p style="margin:0; font-size:15px; font-weight:700; color:#111827; font-family:'Segoe UI', Arial, sans-serif;">{{subject}}</p>
            </td>
          </tr>

          <!-- Message body -->
          <tr>
            <td style="padding:16px 36px 28px 36px;">
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F9FAFB; border-radius:10px; border:1px solid #E5E7EB;">
                <tr>
                  <td style="padding:24px 28px;">
                    <p style="margin:0 0 4px 0; font-size:11px; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.5px; font-family:'Segoe UI', Arial, sans-serif;">Message</p>
                    <p style="margin:12px 0 0 0; font-size:15px; color:#374151; line-height:1.75; white-space:pre-wrap; font-family:'Segoe UI', Arial, sans-serif;">{{message}}</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding:0 36px;">
              <hr style="border:none; border-top:1px solid #E5E7EB; margin:0;">
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color:#F9FAFB; padding:20px 36px; border-radius:0 0 12px 12px;">
              <p style="margin:0; font-size:13px; color:#6B7280; font-family:'Segoe UI', Arial, sans-serif;">
                You received this message because a company contacted you via TalentAI.
                For support, contact <a href="mailto:contact@talentai.bid" style="color:#0ea5a0; text-decoration:none;">contact@talentai.bid</a>
              </p>
              <p style="margin:10px 0 0 0; font-size:12px; color:#9CA3AF; font-family:'Segoe UI', Arial, sans-serif;">
                &copy; {{year}} TalentAI. All rights reserved.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
