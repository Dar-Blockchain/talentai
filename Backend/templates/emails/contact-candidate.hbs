<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Message from {{companyName}}</title>
</head>
<body style="margin:0; padding:0; background-color:#F3F4F6; font-family:'Segoe UI', Arial, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F3F4F6; padding:40px 0;">
    <tr>
      <td align="center">
        <table width="560" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 2px 16px rgba(0,0,0,0.07);">

          <!-- Logo header -->
          <tr>
            <td style="padding:22px 32px; border-bottom:1px solid #F3F4F6;">
              <table cellpadding="0" cellspacing="0" style="background-color:#141415; border-radius:24px; width:110px; height:28px;">
                <tr>
                  <td align="center" valign="middle" style="padding:0 12px;">
                    <img src="cid:logocompany" alt="TalentAI" height="18" style="display:block; margin:0 auto; border:0; outline:none;">
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:36px 32px 12px 32px;">

              <!-- Sender pill -->
              <table cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
                <tr>
                  <td style="background-color:#F0FDFA; border:1px solid #99F6E4; border-radius:999px; padding:6px 14px;">
                    <p style="margin:0; font-size:12px; font-weight:700; color:#0D9488; font-family:'Segoe UI', Arial, sans-serif; letter-spacing:0.2px;">
                      ✉️ &nbsp;{{companyName}}
                    </p>
                  </td>
                </tr>
              </table>

              <!-- Greeting & subject -->
              <p style="margin:0 0 6px 0; font-size:22px; font-weight:700; color:#111827; line-height:1.3; font-family:'Segoe UI', Arial, sans-serif;">
                {{subject}}
              </p>
              <p style="margin:0 0 28px 0; font-size:14px; color:#6B7280; font-family:'Segoe UI', Arial, sans-serif;">
                Hello <strong style="color:#374151;">{{candidateName}}</strong> — you have a new message from <strong style="color:#374151;">{{companyName}}</strong>.
              </p>

              <!-- Message body -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F9FAFB; border-radius:12px; border-left:3px solid #0D9488;">
                <tr>
                  <td style="padding:22px 24px;">
                    <p style="margin:0; font-size:15px; color:#374151; line-height:1.8; white-space:pre-wrap; font-family:'Segoe UI', Arial, sans-serif;">{{message}}</p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:24px 32px 28px 32px; border-top:1px solid #F3F4F6; margin-top:12px;">
              <p style="margin:0 0 6px 0; font-size:12px; color:#9CA3AF; font-family:'Segoe UI', Arial, sans-serif;">
                You received this message because a company contacted you via TalentAI.
                Need help? <a href="mailto:contact@talentai.bid" style="color:#0D9488; text-decoration:none;">contact@talentai.bid</a>
              </p>
              <p style="margin:0; font-size:11px; color:#D1D5DB; font-family:'Segoe UI', Arial, sans-serif;">
                &copy; {{year}} TalentAI. All rights reserved.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
