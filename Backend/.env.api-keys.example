# ============================================
# Configuration des Clés API - .env.example
# ============================================
# Copiez ce fichier en .env.local et remplissez vos valeurs

# Configuration de base
NODE_ENV=development
PORT=5000

# Variables JWT
JWT_SECRET=votre_secret_jwt_ici
JWT_EXPIRATION=7d

# ============================================
# CLÉS API POUR SERVICES EXTERNES
# ============================================

# Frontend Application
FRONTEND_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxx

# Mobile Application
MOBILE_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxx

# Backend Service (pour communication inter-services)
BACKEND_SERVICE_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxx

# Third-party Service
THIRD_PARTY_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxx

# ============================================
# CONFIGURATION DES SCOPES PAR DÉFAUT
# ============================================

# Scopes pour Frontend
FRONTEND_SCOPES=read:posts,write:posts,read:profiles

# Scopes pour Mobile
MOBILE_SCOPES=read:posts

# Scopes pour Backend
BACKEND_SCOPES=read:posts,write:posts,read:profiles,write:profiles,read:metrics,write:payments

# ============================================
# CONFIGURATION RATE LIMITING
# ============================================

# Limite par défaut (requêtes par heure)
DEFAULT_RATE_LIMIT=1000
FRONTEND_RATE_LIMIT=5000
MOBILE_RATE_LIMIT=2000
BACKEND_RATE_LIMIT=10000

# ============================================
# CONFIGURATION DE SÉCURITÉ
# ============================================

# Whitelist IP (séparé par des virgules)
# FRONTEND_IP_WHITELIST=192.168.1.1,10.0.0.1
# MOBILE_IP_WHITELIST=192.168.1.100

# Expiration des clés API (au format ISO 8601)
# FRONTEND_API_EXPIRES_AT=2025-12-31T23:59:59Z
# MOBILE_API_EXPIRES_AT=2025-12-31T23:59:59Z

# ============================================
# EXEMPLE DE UTILISATION
# ============================================
# 
# Dans votre code Node.js:
# const apiKey = process.env.FRONTEND_API_KEY;
# 
# Or pass to requests:
# fetch(url, {
#   headers: { 'Authorization': `Bearer ${apiKey}` }
# })
