{
  "name": "express-project",
  "version": "1.0.0",
  "description": "Un projet Express.js",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/.*\\.test\\.js --testPathIgnorePatterns=tests/integration",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:models": "jest --testPathPattern=tests/models",
    "test:controllers": "jest --testPathPattern=tests/controllers",
    "test:routes": "jest --testPathPattern=tests/routes",
    "test:middleware": "jest --testPathPattern=tests/middleware",
    "test:debug": "jest --detectOpenHandles --forceExit",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.63.0",
    "@hashgraphonline/conversational-agent": "0.1.205",
    "@hashgraphonline/standards-sdk": "^0.0.160",
    "@langchain/community": "^0.3.49",
    "@langchain/core": "^0.3.66",
    "agenda": "^5.0.0",
    "axios": "^1.8.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "google-auth-library": "^9.15.1",
    "hedera-agent-kit": "3.0.5",
    "ipinfo": "^1.5.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.7",
    "openai": "^4.94.0",
    "pdfkit": "^0.17.1",
    "puppeteer": "^24.12.1",
    "qrcode": "^1.5.4",
    "redis": "^5.1.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "together-ai": "^0.16.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4"
  }
}
