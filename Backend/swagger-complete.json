  "paths": {
    "/": {
      "get": {
        "tags": ["Welcome"],
        "summary": "Page d'accueil",
        "security": [],
        "responses": {
          "200": {
            "description": "Message de bienvenue",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Bienvenue sur l'API Express!"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Inscription utilisateur",
        "description": "Inscription d'un nouvel utilisateur avec envoi d'un code OTP par email",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "utilisateur@example.com"
                  }
                },
                "required": ["email"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Inscription réussie"
          },
          "400": {
            "description": "Données invalides"
          }
        }
      }
    },
    "/auth/verify-otp": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Vérification OTP",
        "description": "Vérification du code OTP reçu par email",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "otp": {
                    "type": "string"
                  }
                },
                "required": ["email", "otp"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email vérifié avec succès"
          },
          "400": {
            "description": "Code OTP invalide"
          }
        }
      }
    },
