{
  "info": {
    "name": "Unreviewed Interviews KPI API",
    "description": "Collection for testing AI-generated Interviews unreviewed for 48+ hours KPI endpoints",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1️⃣ KPI - Count Unreviewed (> 48h)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/post-interview-assessments/company/mine/kpi/unreviewed-48h",
          "host": ["{{baseUrl}}"],
          "path": [
            "post-interview-assessments",
            "company",
            "mine",
            "kpi",
            "unreviewed-48h"
          ]
        },
        "description": "Get count of AI-generated interviews that haven't been reviewed for 48+ hours\n\nResponse includes:\n- count: Total unreviewed > 48h\n- urgent: Unreviewed > 72h (very urgent)\n- lastCheck: Timestamp of check\n\nNote: All interviews in PostInterviewAssessment are AI-generated"
      },
      "response": [
        {
          "name": "Success - Has Unreviewed Interviews",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/post-interview-assessments/company/mine/kpi/unreviewed-48h",
              "host": ["{{baseUrl}}"],
              "path": [
                "post-interview-assessments",
                "company",
                "mine",
                "kpi",
                "unreviewed-48h"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ],
          "cookie": [],
          "body": "{\n  \"success\": true,\n  \"message\": \"12 AI interviews pending recruiter review (3 urgent - over 72h)\",\n  \"data\": {\n    \"count\": 12,\n    \"urgent\": 3,\n    \"lastCheck\": \"2026-05-11T14:30:00.000Z\",\n    \"description\": \"AI-generated interviews pending recruiter feedback for 48+ hours\"\n  }\n}\n"
        }
      ]
    },
    {
      "name": "2️⃣ KPI - Get Details (Page 1)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
