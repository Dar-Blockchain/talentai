        "url": {
          "raw": "{{baseUrl}}/post-interview-assessments/company/mine/kpi/unreviewed-48h/details?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": [
            "post-interview-assessments",
            "company",
            "mine",
            "kpi",
            "unreviewed-48h",
            "details"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        },
        "description": "Get paginated list of AI interviews unreviewed for 48+ hours\n\nQuery params:\n- page: Page number (default 1)\n- limit: Records per page (default 10)\n- postId: (optional) Filter by specific post\n\nResponse includes each interview with:\n- candidateName, candidateEmail\n- postTitle\n- completedAt: Interview end date\n- hoursPending: Hours since completion\n- isUrgent: true if > 72h\n- overallScore: AI score 0-100\n- aiGenerated: Always true (AI interviews only)"
      },
      "response": [
        {
          "name": "Success - Paginated List",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/post-interview-assessments/company/mine/kpi/unreviewed-48h/details?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": [
                "post-interview-assessments",
                "company",
                "mine",
                "kpi",
                "unreviewed-48h",
                "details"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ],
          "cookie": [],
          "body": "{\n  \"success\": true,\n  \"message\": \"Unreviewed interviews retrieved successfully\",\n  \"data\": [\n    {\n      \"_id\": \"507f1f77bcf86cd799439011\",\n      \"candidateName\": \"Jean Dupont\",\n      \"candidateEmail\": \"jean@example.com\",\n      \"postTitle\": \"Senior Developer\",\n      \"completedAt\": \"2026-05-09T10:30:00.000Z\",\n      \"hoursPending\": 52,\n      \"isUrgent\": false,\n      \"overallScore\": 78,\n      \"aiGenerated\": true\n    },\n    {\n      \"_id\": \"507f1f77bcf86cd799439012\",\n      \"candidateName\": \"Marie Martin\",\n      \"candidateEmail\": \"marie@example.com\",\n      \"postTitle\": \"Product Manager\",\n      \"completedAt\": \"2026-05-08T14:15:00.000Z\",\n      \"hoursPending\": 74,\n      \"isUrgent\": true,\n      \"overallScore\": 82,\n      \"aiGenerated\": true\n    },\n    {\n      \"_id\": \"507f1f77bcf86cd799439013\",\n      \"candidateName\": \"Pierre Bernard\",\n      \"candidateEmail\": \"pierre@example.com\",\n      \"postTitle\": \"Data Scientist\",\n      \"completedAt\": \"2026-05-07T09:00:00.000Z\",\n      \"hoursPending\": 101,\n      \"isUrgent\": true,\n      \"overallScore\": 85,\n      \"aiGenerated\": true\n    }\n  ],\n  \"pagination\": {\n    \"page\": 1,\n    \"limit\": 10,\n    \"totalCount\": 12,\n    \"totalPages\": 2\n  },\n  \"metadata\": {\n    \"timestamp\": \"2026-05-11T14:30:00.000Z\",\n    \"allInterviewsAreAIGenerated\": true,\n    \"sortedByOldestFirst\": true\n  }\n}\n"
        }
      ]
    },
    {
